# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Nairobi

# Database
POSTGRES_DB=modotech_crm
POSTGRES_USER=modotech
POSTGRES_PASSWORD=modotech
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery / Channels
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# WhatsApp Cloud API — see Meta Business Suite / developers.facebook.com
# All of these are numeric IDs from the WhatsApp > API Setup page, NOT
# the phone number itself. WHATSAPP_PHONE_NUMBER_ID in particular is easy
# to mix up with the actual phone number (e.g. +15556638730) — it should
# instead look like 1261989706997192 (also visible in any inbound webhook
# payload under value.metadata.phone_number_id).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Only set these if onboarding through 360dialog's Coexistence flow
# instead of a direct Meta Tech Provider integration:
#   WHATSAPP_PROVIDER=360dialog
#   WHATSAPP_GRAPH_BASE_URL=https://waba-v2.360dialog.io
# ...and set WHATSAPP_ACCESS_TOKEN to your 360dialog "D360 API Key" (found
# in 360dialog Hub / API keys), not a Meta access token — they're
# different credentials with a different format. Leave
# WHATSAPP_PHONE_NUMBER_ID blank in this mode; 360dialog's API key is
# already scoped to a specific number, so it isn't needed in requests.
# Also generate a 360dialog "Platform Secret" (docs.360dialog.com ->
# search "Generate Platform Secret") and set it here — this is a
# DIFFERENT value from WHATSAPP_APP_SECRET above, used specifically to
# verify inbound webhook signatures from 360dialog rather than Meta:
#   WHATSAPP_WEBHOOK_SECRET=

# If you're on WhatsApp Coexistence: it syncs prior chat history into
# the API side when a number is first connected, which otherwise shows
# up in the CRM as if it were new. Set this to the date you actually
# went live (YYYY-MM-DD) and anything from before it gets silently
# skipped instead of creating conversations. Leave blank to process
# everything (the default, and what you want if you're not on Coexistence).
WHATSAPP_HISTORY_CUTOFF_DATE=

# ISP integration (swap class once the real billing system is ready)
ISP_SERVICE_CLASS=apps.integrations.services.isp.MockISPService

# AI assistant (optional for MVP)
AI_SERVICE_CLASS=apps.integrations.services.ai.NullAIService
AI_API_KEY=

# Production only
SECURE_SSL_REDIRECT=True
